---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  socialDescription?: string;
  type?: 'website' | 'article';
  schema?: unknown[];
  noindex?: boolean;
}

const { title, description, socialDescription = description, type = 'website', schema = [] } = Astro.props;
const noindex = Astro.props.noindex || (process.env.VERCEL_ENV && process.env.VERCEL_ENV !== 'production');
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/images/social-preview.png', Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {!Astro.props.noindex && <link rel="canonical" href={canonical} />}
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large'} />
    <meta name="theme-color" content="#0f0f0f" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Vox0" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Vox0 — free offline dictation for Windows" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Vox0 — free offline dictation for Windows" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Apply the saved theme before paint to avoid a flash on return visits.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var wantsLight = saved ? saved === 'light'
          : window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.setAttribute('data-theme', wantsLight ? 'light' : 'dark');
      })();
    </script>
    {schema.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/theme.js';
    </script>
  </body>
</html>
